generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
}

model User {
  id              String    @id @default(cuid()) @map("_id")
  name            String?
  email           String?   @unique
  hashedPassword  String?
  emailVerified   DateTime? @map("email_verified")
  image           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  booking         Booking[]
  // accounts      Account[]
  // sessions      Session[]

}

model Villa {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  area        String
  cost        Int
  name        String
  rating      Int
  villaNumber Int
  ammenities  Json?
  booing      Booking[]
}


model Booking {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  from        String
  to          String
  status      String
  user        User          @relation(fields: [userId], references: [id])
  villa       Villa         @relation(fields: [villaId], references: [id])
  villaId     String        @db.ObjectId
  userId      String          
}


